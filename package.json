{
  "name": "neare",
  "private": true,
  "version": "1.0.0",
  "description": "NEARE — hyperlocal multi-vendor marketplace",
  "scripts": {
    "dev": "npx concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "test": "npm test --prefix server && npm test --prefix client",
    "lint": "npm run lint --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
